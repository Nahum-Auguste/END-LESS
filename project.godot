[application]

config/name="EndLess"
run/main_scene="uid://cddegqmyalex2"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InventoryManager="*uid://bkhc40jsxthe5"
GroundGuiCanvas="*uid://del2ua8ddsqph"
